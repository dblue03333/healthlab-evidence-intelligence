{
  "schema_version": "signal-registry-3",
  "sources": [
    {
      "source_id": "moh_portal",
      "organization": "Bộ Y tế Việt Nam",
      "kind": "html",
      "url": "https://moh.gov.vn/",
      "geography": "Vietnam",
      "enabled": true,
      "required": true,
      "max_documents": 6,
      "max_article_fetches": 180,
      "usage_policy": "Official Ministry portal public read-only POST API. Configured news categories only: highlights, leadership, direction, general news, local news and health policy. Each bounded newest-first inventory must reach before the publication window with verified descending dates, or exhaust its reported total. No exhaustive website claim. JSON raw and publication evidence retained; media never fetched.",
      "html_rules": {
        "rule_id": "moh_portal",
        "host": "moh.gov.vn",
        "article_urls": {
          "include_path_patterns": [
            "/index\\.jsp"
          ],
          "required_query_parameters": {
            "pageId": "5803",
            "aid": "[1-9][0-9]*",
            "cid": "[1-9][0-9]*"
          }
        },
        "body": {
          "attributes": {
            "id": "portal-body"
          }
        },
        "standard_date_metadata": false
      },
      "html_discovery": {
        "moh_portal_categories": [
          "8358",
          "8351",
          "8360",
          "8356",
          "8355",
          "8338"
        ],
        "portal_inventory_size": 1000,
        "max_listing_pages": 6,
        "skip_outside_window": true
      },
      "html_media_policy": "text_only"
    },
    {
      "source_id": "hcm_health",
      "organization": "Sở Y tế TP.HCM",
      "kind": "html",
      "url": "https://medinet.hochiminhcity.gov.vn/tin-tuc-su-kien-c1780.aspx",
      "geography": "Ho Chi Minh City, Vietnam",
      "enabled": true,
      "required": true,
      "max_documents": 6,
      "max_article_fetches": 100,
      "usage_policy": "Tin tuc su kien category; newsletter selection by source-displayed calendar date: listing card, then article update, then explicit publication. Original publication remains separate. Sequential pagination and chronological displayed-date boundary; up to six category listings plus a bounded blank-key public search supplement (up to seven pages, 100-result cap, verified date boundary). Outside-window cards retain raw listing evidence without implying article content was read. Missing/conflicting selection dates require review.",
      "html_rules": {
        "rule_id": "hcm_medinet",
        "revision": 2,
        "window_date_policy": "source_displayed",
        "host": "medinet.hochiminhcity.gov.vn",
        "article_urls": {
          "include_path_patterns": [
            ".*-c1780-\\d+\\.[aA][sS][pP][xX]"
          ]
        },
        "body": {
          "classes": [
            "ContentODM"
          ]
        },
        "article_scope": {
          "classes": [
            "contentNew"
          ]
        },
        "require_article_scope": false,
        "lead": {
          "classes": [
            "sapodetail"
          ]
        },
        "text_dates": [
          {
            "selector": {
              "tag": "div",
              "classes": [
                "time"
              ]
            },
            "kind": "modified",
            "scope": "article_children",
            "format": "%d/%m/%Y",
            "pattern": "Cập nhật:\\s*\\d{1,2}:\\d{1,2},\\s*(?P<date>\\d{1,2}/\\d{1,2}/\\d{4})(?:\\s.*)?"
          }
        ],
        "listing_date": {
          "selector": {
            "classes": [
              "time"
            ]
          }
        }
      },
      "html_discovery": {
        "listing_path_patterns": [
          "/tin-tuc-su-kien-c1780(?:-p\\d+)?\\.aspx"
        ],
        "hcm_search_inventory": true,
        "chronological_scope": {"attributes": {"id": "plcall_dtn_UpdatePanel1"}},
        "pagination_selector": {
          "classes": [
            "pagination"
          ]
        },
        "upgrade_same_host_http": true,
        "max_listing_pages": 6,
        "sequential_page_pattern": "/tin-tuc-su-kien-c1780(?:-p(?P<page>\\d+))?\\.aspx",
        "stop_before_window": true,
        "skip_outside_window": true
      },
      "html_media_policy": "text_only"
    },
    {
      "source_id": "who_ageing",
      "organization": "World Health Organization",
      "kind": "html",
      "url": "https://www.who.int/health-topics/ageing",
      "geography": "International; Vietnam relevance requires review",
      "enabled": true,
      "required": true,
      "max_documents": 4,
      "max_article_fetches": 100,
      "usage_policy": "WHO Ageing landing plus Vietnam-office releases/features/commentaries/speeches; explicit page-1 seeds and sequential chronological pagination. Global filtered All news is outside domestic scope. Bound publication dates permit audited out-of-window content skips. Ageing includes only its declared top-three news widget snapshot, not all global news or historical widget membership. HTML responses bounded at 32MB after observing a 22.5MB article with embedded images; no linked media is fetched and no exhaustive website claim.",
      "html_rules": {
        "rule_id": "who_news",
        "host": "www.who.int",
        "article_urls": {
          "include_path_patterns": [
            "/news/item/.*",
            "/vietnam/news/detail/.*",
            "/vietnam/news/feature-stories/item/.*",
            "/vietnam/news/commentaries/detail/.*",
            "/vietnam/news/speeches/speech/.*"
          ]
        },
        "body": {
          "classes": [
            "sf-detail-body-wrapper"
          ]
        },
        "text_dates": [
          {
            "selector": {
              "classes": [
                "timestamp"
              ]
            },
            "kind": "published",
            "scope": "document",
            "format": "%d %B %Y",
            "fallback_only": true
          }
        ],
        "revision": 2,
        "listing_date": {
          "selector": {
            "classes": [
              "timestamp"
            ]
          },
          "format": "%d %B %Y",
          "max_ancestor_levels": 4
        }
      },
      "html_discovery": {
        "additional_listing_urls": [
          "https://www.who.int/vietnam/news/releases/1",
          "https://www.who.int/vietnam/news/feature-stories/1",
          "https://www.who.int/vietnam/news/commentaries/1",
          "https://www.who.int/vietnam/news/speeches/1"
        ],
        "listing_path_patterns": [
          "/vietnam/news/(?:releases|feature-stories|commentaries|speeches)(?:/\\d+)?"
        ],
        "drop_query_parameters": [
          "_x_tr_pto",
          "_x_tr_sl",
          "_x_tr_tl",
          "_x_tr_hl"
        ],
        "max_listing_pages": 12,
        "who_speeches_api": true,
        "who_ageing_widget": true,
        "who_speeches_max_pages": 2,
        "api_page_size": 100,
        "stop_before_window": true,
        "skip_outside_window": true,
        "sequential_page_pattern": "/(?:health-topics/ageing|vietnam/news/(?:releases|feature-stories|commentaries|speeches)(?:/(?P<page>\\d+))?)"
      },
      "html_max_response_bytes": 32000000,
      "html_media_policy": "text_only"
    }
  ]
}
