# FPT AI Provider
FPT_API_KEY=your_fpt_api_key_here
FPT_BASE_URL=https://mkp-api.fptcloud.com/v1
FPT_MODEL_NAME=DeepSeek-V4-Flash
FPT_MAX_TOKENS=4096
FPT_TIMEOUT=60

# NCBI / PubMed (Optional: increases rate limit from 3 req/s to 10 req/s)
NCBI_API_KEY=
NCBI_EMAIL=your_email@example.com

# App settings
HEALTHLAB_ENV=development
DATA_DIR=data
HEALTHLAB_STORE_DIR=outputs

# Optional CP12 provider. Explicit model and endpoint; no fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_PROVIDER=
OPENROUTER_TIMEOUT=60
OPENROUTER_MAX_TOKENS=4096

# Optional Gemini provider. Key inherits billing/quota from its Google project.
# Keep testing project on Free Tier in AI Studio if no paid inference is intended.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.8-flash
GEMINI_TIMEOUT=90
# Includes reasoning tokens; low thinking reduces latency without disabling reasoning.
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=1.0
GEMINI_THINKING_LEVEL=low

# Signal pilot — Gmail SMTP. Keep real values in local .env, never Git/chat.
# App password requires an eligible Gmail account with 2-Step Verification.
HEALTHLAB_GMAIL_USER=
HEALTHLAB_GMAIL_APP_PASSWORD=
HEALTHLAB_EMAIL_TO=

# Optional Signal collector cloud backend; use a direct/session PostgreSQL URL.
# Keep the real URL in .env/Secret Manager. GCS uses Application Default Credentials.
HEALTHLAB_SIGNAL_DATABASE_URL=
