# FPT AI Provider
FPT_API_KEY=your_fpt_api_key_here
FPT_BASE_URL=https://mkp-api.fptcloud.com/v1
FPT_MODEL_NAME=gpt-oss-120b
FPT_MAX_TOKENS=4096
FPT_TIMEOUT=60

# NCBI / PubMed (Optional: increases rate limit from 3 req/s to 10 req/s)
NCBI_API_KEY=
NCBI_EMAIL=your_email@example.com

# App settings
HEALTHLAB_ENV=development
DATA_DIR=data
HEALTHLAB_STORE_DIR=outputs
