# FPT AI Provider
FPT_API_KEY=your_fpt_api_key_here
FPT_BASE_URL=https://mkp-api.fptcloud.com/v1
FPT_MODEL_NAME=DeepSeek-V4-Flash
# Explicit final-answer profile. Use provider_default to omit the option for other models.
FPT_THINKING_MODE=disabled
# Includes reasoning tokens; incomplete responses remain failed and are never auto-retried.
FPT_MAX_TOKENS=8192
FPT_TIMEOUT=60
# Second model for the recall check over held-back articles (healthlab.editorial.recall).
HEALTHLAB_RECALL_MODEL=GLM-5.2

# NCBI / PubMed (Optional: increases rate limit from 3 req/s to 10 req/s)
NCBI_API_KEY=
NCBI_EMAIL=your_email@example.com

# App settings
HEALTHLAB_ENV=development
DATA_DIR=data
HEALTHLAB_STORE_DIR=outputs
# Diagnostics on stderr: DEBUG, INFO, WARNING or ERROR. Read from the process environment.
HEALTHLAB_LOG_LEVEL=INFO

# Editorial issue email — Gmail SMTP. Keep real values in local .env, never Git/chat.
# App password requires an eligible Gmail account with 2-Step Verification.
HEALTHLAB_GMAIL_USER=
HEALTHLAB_GMAIL_APP_PASSWORD=
HEALTHLAB_EMAIL_TO=

# Optional Signal collector cloud backend; use a direct/session PostgreSQL URL.
# Keep the real URL in .env/Secret Manager. GCS uses Application Default Credentials.
HEALTHLAB_SIGNAL_DATABASE_URL=
